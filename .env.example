# Copy this file to .env and fill in your values
PORT=3000
BASE_URL=http://localhost:3000
TRUST_PROXY=0

# Turso (leave blank for local SQLite development)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional local SQLite path for the app (default: ./finassist.db)
DB_PATH=./finassist.db
# Optional source path for npm run migrate:turso (default: ./finassist.db)
SQLITE_DB_PATH=./finassist.db


# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
BILL_ANALYSIS_MODEL=openai/gpt-4o-mini

# Email (Resend API). Verify your sending domain in Resend first.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM="AIPFA <hello@your-verified-domain.example>"

# Optional SMTP fallback (only used when Resend/Unosend/Brevo is not configured)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=your-mailbox@example.com
# SMTP_PASS=your-mail-provider-app-password
# MAIL_FROM=your-mailbox@example.com

